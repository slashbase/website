---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const formatDate = (date: Date) =>
  date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
  });
---
<Layout>
    <main class="blog">
        <h1>Journal - Thoughts & Stories</h1>
        <ul class="posts">
            {posts.map((post) => (
            <li class="post-card">
                <a href={`/blog/${post.id}/`} class="post-head">{post.data.title}</a>
                <time datetime={post.data.pubDate.toISOString()}>
                {formatDate(post.data.pubDate)}
                </time>
                <p>{post.data.description}</p>
            </li>
            ))}
        </ul>
    </main>
</Layout>

<style>
  .blog {
    max-width: 720px;
    margin: 0 auto;
    padding: clamp(2rem, 8vw, 4rem) clamp(1rem, 5vw, 1.5rem);
    overflow-wrap: break-word;
  }
  .blog h1 { font-size: 2.5rem; margin: 0 0 0.5rem; }
  .post-card {
    display: block;
    padding: clamp(1rem, 4vw, 1.25rem) clamp(1rem, 5vw, 1.5rem);
    text-decoration: none;
    color: inherit;
    overflow-wrap: break-word;
    -webkit-tap-highlight-color: transparent;
  }

  .post-card:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: -2px;
  }
  .posts { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .post-head { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; flex-wrap: wrap; }
  .post-card time { font-size: 0.8rem; color: var(--muted, #888); }
  .post-card p { margin: 0.5rem 0 0; color: var(--muted, #888); }
</style>